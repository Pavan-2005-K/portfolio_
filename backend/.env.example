# Copy this file to ".env" and fill in real values. Never commit ".env".

# MongoDB Atlas connection string (database name "portfolio" is set in code via dbName)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Local Express server port. Vercel assigns its own function ports.
PORT=5000

# Allowed frontend origin(s), comma separated, no trailing slash
# Local example: http://localhost:3000,http://127.0.0.1:3000
# Production example: https://your-portfolio.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pavan-portfolio-tan-eta.vercel.app

# development | production
NODE_ENV=development
